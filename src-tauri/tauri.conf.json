{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Helper",
  "version": "1.0.0",
  "identifier": "com.aihelper.matrix",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Helper - Cyber Matrix",
        "width": 1020,
        "height": 720,
        "minWidth": 800,
        "minHeight": 580,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "floating_ball",
        "title": "AI Helper Floating Orb",
        "width": 72,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "url": "index.html#floating"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
